#Function 
prepare_PCA_and_scree = function(geno_input, analysis_name) {
  
 PCA = prcomp(geno_input, center = TRUE, scale. = FALSE)
  
 PCs = PCA$x %>%  as.data.frame() %>% dplyr::select(PC1, PC2, PC3) %>% tibble::rownames_to_column("id") %>% dplyr::mutate(analysis = analysis_name)
   
 variance_explained = PCA$sdev^2 / sum(PCA$sdev^2) * 100
 
 scree_df    = data.frame(PC = seq_along(PCA$sdev), eigenvalue = PCA$sdev^2)
  
 PCA_plot    = PCs %>% ggplot(aes(x = PC1, y = PC2)) + 
               geom_point(shape = 21, size = 2, alpha = 0.8, stroke = 0.1, fill = analysis_colors[analysis_name], color = "black") +
               labs(x = sprintf("PC1 (%.2f%%)", variance_explained[1]), y = sprintf("PC2 (%.2f%%)", variance_explained[2])) +
               theme_bw() +
               theme(legend.position = "none", panel.border = element_rect(color = "black", fill = NA, linewidth = 0.6)) +
               facet_grid(~ analysis)
  
  scree_plot = ggplot(scree_df %>% dplyr::filter(PC <= 10), aes(x = PC, y = eigenvalue)) +
               geom_line(color  = "black", linewidth = 0.8) +
               geom_point(color = "black", size = 1.5) +
               scale_x_continuous(breaks = 1:10) +
               labs(x = "Component number", y = "Eigenvalue") +
               theme_bw() +
               theme(axis.text.x  = element_text(size = 7), 
                     axis.text.y  = element_text(size = 7),
                     axis.title.y = element_text(size = 8),
                     panel.grid   = element_blank(),
                     plot.margin  = margin(2, 2, 2, 2),
                     panel.background = element_rect(fill = "transparent", color = NA),
                     plot.background = element_rect(fill = "transparent",color = NA))
               
  combined_plot = scree_plot / PCA_plot + patchwork::plot_layout(heights = c(1.25, 4))
  
  return(combined_plot) }
  
  #Run function
  PCA_SSA  = prepare_PCA_and_scree(geno_SSA,  "SSA")
  PCA_GWAS = prepare_PCA_and_scree(geno_GWAS, "GWAS")
  PCA_GP   = prepare_PCA_and_scree(geno_GP,   "GP")

