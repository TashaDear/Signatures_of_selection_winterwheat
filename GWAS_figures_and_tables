LDblocks           = data.frame()

for(current_threshold in c(0.1, 0.2)) {
   
  LD_kbp           = thresholds_LD %>% dplyr::filter(adjustment == "Q+K", r2 == current_threshold) %>% dplyr::pull(D_kbp)

  LD_bp            = LD_kbp * 1000

  intervals        = SSA_output %>%
                     dplyr::left_join(map, by = "SNP") %>%
                     dplyr::filter(!is.na(CHROM), CHROM != "ChrUnknown") %>%
                     dplyr::select(CHROM, POS) %>%
                     dplyr::mutate(start = POS - LD_bp, end = POS + LD_bp) %>%
                     dplyr::left_join(genome_size %>% dplyr::mutate(CHROM = sub("^Chr", "", CHROM)), by = "CHROM") %>%
                     dplyr::mutate(start = pmax(start, 1), end = pmin(end, END)) %>%
                     dplyr::select(CHROM, start, end) %>% as.data.table()

  setorder(intervals, CHROM, start)

  intervals[, running_end := cummax(end), by = CHROM]

  intervals[, grp := cumsum(start > c(running_end[1], running_end[-.N])), by = CHROM]

  merged           = intervals[, .(start = min(start), end = max(end)), by = .(CHROM, grp)]

  chr_coverage     = merged[, .(covered_bp = sum(end - start + 1)), by = CHROM] %>%
                     dplyr::left_join(genome_size %>% 
                     dplyr::mutate(CHROM = sub("^Chr", "", CHROM)), by = "CHROM")

  genome_coverage = chr_coverage %>%
                    dplyr::summarise(covered_bp = sum(covered_bp), genome_bp = sum(END)) %>%
                    dplyr::mutate(coverage_pct = round(100 * covered_bp / genome_bp, 1), LD_kbp = LD_kbp, threshold = current_threshold)

  LDblocks        = rbind(LDblocks, genome_coverage) }

