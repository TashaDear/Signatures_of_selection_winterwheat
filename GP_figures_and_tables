LLR_test           = likelihoods_MK %>% 
                     tidyr::pivot_wider(names_from = random_model, values_from = llik) %>%
                     left_join(ll_SK_unpermuted , by = "trait") %>% 
                     dplyr::mutate(LLR_M1M2  = 2 * (M2 - M1), 
                                   LLR_M2M3  = 2 * (M3 - M2),
                                   LLR_M1M3  = 2 * (M3 - M1),
                                   pval_M1M2 = round(pchisq(LLR_M1M2, df=1, lower.tail=FALSE),10),
                                   pval_M2M3 = round(pchisq(LLR_M2M3, df=1, lower.tail=FALSE),10),
                                   pval_M1M3 = round(pchisq(LLR_M1M3, df=2, lower.tail=FALSE),10)) %>%
                     tidyr::pivot_longer(cols = c(LLR_M1M2, LLR_M2M3, LLR_M1M3, 
                                                  pval_M1M2, pval_M2M3, pval_M1M3), names_to = c(".value","comparison"),
                                                                                    names_pattern = "(LLR|pval)_(.*)") %>%
                     dplyr::select(-c("M1", "M2", "M3")) %>% 
                     left_join(get_empirical_LLR(.), by = c("trait", "quantile", "comparison")) %>%
                     dplyr::filter(permuted == "no") %>% 
                     dplyr::select(trait, quantile, comparison, LLR, pval, p_empirical) %>%
                     dplyr::mutate(comparison = factor(gsub("(M\\d)(M\\d)", "\\1-\\2", comparison), levels = c("M1-M2", "M2-M3", "M1-M3"))) %>%
                     dplyr::mutate(signif = ifelse(p_empirical <= 0.05, "<= 0.05", "> 0.05")) %>%
                     dplyr::mutate(signif = factor(signif, levels = c("> 0.05", "<= 0.05"))) %>%
                     rename_traits()
                     
chi_thresholds     = data.frame(comparison = unique(LLR_test$comparison), threshold = c(qchisq(0.95, 1), qchisq(0.95, 1), qchisq(0.95, 2)))
                                   
LLR_plot           = ggplot(LLR_test,aes(x = factor(quantile), y = LLR, color = comparison, group = comparison)) +
                     geom_line(linewidth = 0.8) +
                     geom_point(aes(shape = signif), size = 2, stroke = 1.2) +
                     scale_shape_manual(name = "Empirical p-value", values = c("<= 0.05" = 16, "> 0.05" = 1)) +
                     scale_color_viridis_d() + guides(color = "none") +
                     geom_hline(data = chi_thresholds, aes(yintercept = threshold), 
                                linetype = "dashed", color = "red", linewidth = 1, inherit.aes = FALSE) +
                     facet_grid(comparison ~ trait) +
                     theme_bw() +
                     labs(x = "Minimum score percentile", y = "LLR-statistics") +
                     theme(legend.position = "bottom",
                           strip.text  = element_text(size = 12),
                           axis.text.x = element_text(angle = 90, hjust = 1, vjust = 0.5)) 
                                                                  
