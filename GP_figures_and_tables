#Function 1
rename_traits      = function(df) {

df %>% dplyr::mutate(trait = recode(trait, "Protein" = "GPD", "Plantheight" = "Plant height")) }

#Function 2 (Mean partition)
get_empirical_p    = function(df) {
  
                      df %>%
                      group_by(trait, quantile, covariate) %>%
                      summarise(obs_zscore = z[permute == "no"][1],
                                r          = {permuted_yes <- z[permute == "yes"]
                      if (obs_zscore > 0) { sum(permuted_yes >= obs_zscore)
              
               } else if (obs_zscore < 0) { sum(permuted_yes <= obs_zscore)
            
               } else { 0 }},
              
               n = sum(permute == "yes"),
               p_empirical = (r + 1) / (n + 1), .groups = "drop") %>% ungroup() %>%
               dplyr::select(trait, quantile, covariate, p_empirical) }
               
#Function 3 (Variance partition)
get_empirical_LLR = function(df) {
  
                    df %>%
                    dplyr::group_by(trait, quantile, comparison) %>%
                    dplyr::summarise(obs_LLR = LLR[permuted == "no"][1], permuted_yes = list(LLR[permuted == "yes"]),
                                     n = sum(permuted == "yes"), r = sum(unlist(permuted_yes) >= obs_LLR), p_empirical = (r + 1) / (n + 1),
                    .groups = "drop") %>% dplyr::select(trait, quantile, comparison, p_empirical) }

